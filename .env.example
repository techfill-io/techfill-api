# Backend Environment Variables
# Copy this file to .env and replace the placeholder values

# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_PUBLISHABLE_KEY=sb_publishable_NtfZJF5R_o6NMBpb3cGWig_4SaljXpM

# Database (Direct connection - optional, for migrations)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# JWT Configuration (for custom JWT if needed)
JWT_SECRET=your-jwt-secret-key-change-this-to-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,https://techfill.com

# Storage Buckets
STORAGE_BUCKET_CVS=cvs
STORAGE_BUCKET_LOGOS=company-logos

# Instructions:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Project Settings (gear icon) > API
# 4. Copy "Project URL" and replace YOUR_SUPABASE_PROJECT_URL
# 5. Copy "Secret key" (starts with sb_secret_...) and replace YOUR_SUPABASE_SECRET_KEY
# 6. Scroll down and copy "JWT Secret" and replace YOUR_JWT_SECRET
# 7. Go to Project Settings > Database and copy connection string
